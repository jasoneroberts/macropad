/*
 * nRF52840 DK breadboard set-up for the macropad (concept B screen).
 *
 * Wiring (DK Arduino header names):
 *   2.0" Waveshare ST7789 LCD   VCC -> VDD, GND -> GND, DIN -> D11 (P1.13), CLK -> D13 (P1.15),
 *                               CS -> D10 (P1.12), DC -> D9 (P1.11), RST -> D8 (P1.10), BL -> D7 (P1.08)
 *   EC11 knob                   A -> D2 (P1.04), B -> D3 (P1.05), C -> GND,
 *                               push switch -> D4 (P1.06) and GND
 *   Keys                        DK buttons 1-4 act as the first four keys (back row)
 *
 * Key numbering: key n reaches the app as INPUT_KEY_F13 + n (knob push = key 16). The F13
 * name is only an ID inside the firmware; what the PC receives comes from src/Keymap.c.
 */

#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	chosen {
		zephyr,display = &lcd;
	};

	aliases {
		backlight = &lcd_backlight;
	};

	hid_dev_0: hid_dev_0 {
		compatible = "zephyr,hid-device";
		label = "HID0";
		protocol-code = "none";
		in-polling-period-us = <1000>;
		in-report-size = <16>;
	};

	knob: knob {
		compatible = "gpio-qdec";
		gpios = <&gpio1 4 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>,
			<&gpio1 5 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
		/* EC11: 4 quadrature edges per detent, so one event per click */
		steps-per-period = <4>;
		zephyr,axis = <INPUT_REL_WHEEL>;
		sample-time-us = <1000>;
		idle-timeout-ms = <200>;
	};

	knob_keys {
		compatible = "gpio-keys";

		knob_push: knob_push {
			gpios = <&gpio1 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Knob push";
			/* the knob push is key 16 on every concept */
			zephyr,code = <(INPUT_KEY_F13 + 16)>;
		};
	};

	backlight_pwm {
		compatible = "pwm-leds";

		lcd_backlight: lcd_backlight {
			pwms = <&pwm1 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
			label = "LCD backlight";
		};
	};

	lcd_dbi: lcd_mipi_dbi {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&arduino_spi>;
		dc-gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		/* Waveshare 2inch LCD Module (ST7789V, 240 x 320), used landscape.
		 * Init values from Waveshare's demo code. If the picture is mirrored or
		 * upside down, change mdac: 0x70 / 0xa0 / 0x60 / 0xc0 are the four
		 * landscape options. */
		lcd: st7789v@0 {
			compatible = "sitronix,st7789v";
			reg = <0>;
			/* Jumper wires: keep the clock modest */
			mipi-max-frequency = <8000000>;
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
			width = <320>;
			height = <240>;
			x-offset = <0>;
			y-offset = <0>;
			vcom = <0x1f>;
			gctrl = <0x35>;
			vrhs = <0x12>;
			vdvs = <0x20>;
			mdac = <0x70>;
			gamma = <0x01>;
			colmod = <0x05>;
			lcm = <0x2c>;
			porch-param = [0c 0c 00 33 33];
			cmd2en-param = [5a 69 02 01];
			pwctrl1-param = [a4 a1];
			pvgam-param = [d0 08 11 08 0c 15 39 33 50 36 13 14 29 2d];
			nvgam-param = [d0 08 10 08 06 06 39 44 51 0b 16 14 2f 31];
			ram-param = [00 f0];
			rgb-param = [cd 08 14];
		};
	};
};

&button0 {
	zephyr,code = <INPUT_KEY_F13>;
};

&button1 {
	zephyr,code = <(INPUT_KEY_F13 + 1)>;
};

&button2 {
	zephyr,code = <(INPUT_KEY_F13 + 2)>;
};

&button3 {
	zephyr,code = <(INPUT_KEY_F13 + 3)>;
};

&pwm1 {
	status = "okay";
	pinctrl-0 = <&lcd_bl_pwm_default>;
	pinctrl-1 = <&lcd_bl_pwm_sleep>;
	pinctrl-names = "default", "sleep";
};

&pinctrl {
	lcd_bl_pwm_default: lcd_bl_pwm_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 8)>;
		};
	};

	lcd_bl_pwm_sleep: lcd_bl_pwm_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 8)>;
			low-power-enable;
		};
	};
};
