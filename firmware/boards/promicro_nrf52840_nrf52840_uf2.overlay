/*
 * Macropad concept B on a Pro Micro-size nRF52840 (nice!nano v2 / SuperMini clone).
 * Board: promicro_nrf52840/nrf52840/uf2 (Adafruit UF2 bootloader, app at 0x26000).
 *
 * Pin map (nRF pin, Pro Micro label, footprint pin). The SPI clock and data use
 * full-speed pins; everything slow (matrix, knob, backlight, reset) uses the pins
 * Nordic marks "low frequency I/O only".
 *
 *   LCD SCK   P0.17  D2   5     ROW0  P1.00  D6   9      COL0  P1.06  D9   12
 *   LCD MOSI  P0.20  D3   6     ROW1  P0.11  D7   10     COL1  P1.11  D14  15
 *   LCD CS    P0.22  D4   7     ROW2  P1.04  D8   11     COL2  P1.13  D15  16
 *   LCD DC    P0.24  D5   8     (ROW3 P0.08  D0   2, concept C only)
 *   LCD RST   P1.15  D18  17                              COL3  P0.29  D20  19
 *   LCD BL    P0.02  D19  18    KNOB A P0.09 D10  13      COL4  P0.31  D21  20
 *   (debug TX P0.06  D1   1)    KNOB B P0.10 D16  14
 *
 * The knob sits on the two NFC pins: both rest high (pull-ups, open contacts at a
 * detent), so the small leak NFC pins have when held at different levels never flows.
 *
 * Matrix: rows are inputs with pull-ups, columns are driven low one at a time. Each
 * switch has a 1N4148 from the row side (anode) to the column (cathode).
 */

#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/input/keymap.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>

/ {
	chosen {
		zephyr,display = &lcd;
	};

	aliases {
		backlight = &lcd_backlight;
	};

	/* Battery: the LiPo feeds VDDH, measured as VDDH / 5 (src/Battery.c) */
	zephyr,user {
		io-channels = <&adc 0>;
	};

	/* SuperMini / nice!nano: P0.13 enables the regulator behind the VCC pin, which
	 * powers the LCD module. It is off until firmware drives P0.13 high. */
	vcc_ext: vcc_ext {
		compatible = "regulator-fixed";
		regulator-name = "vcc_ext";
		enable-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
		startup-delay-us = <10000>;
		regulator-boot-on;
	};

	hid_dev_0: hid_dev_0 {
		compatible = "zephyr,hid-device";
		label = "HID0";
		protocol-code = "none";
		in-polling-period-us = <1000>;
		in-report-size = <16>;
	};

	kbd_matrix: kbd_matrix {
		compatible = "gpio-kbd-matrix";
		row-gpios = <&gpio1 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			    <&gpio0 11 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			    <&gpio1 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		col-gpios = <&gpio1 6 GPIO_ACTIVE_LOW>,
			    <&gpio1 11 GPIO_ACTIVE_LOW>,
			    <&gpio1 13 GPIO_ACTIVE_LOW>,
			    <&gpio0 29 GPIO_ACTIVE_LOW>,
			    <&gpio0 31 GPIO_ACTIVE_LOW>;
		/* Every switch has its own diode, so any combination of keys reads correctly */
		no-ghostkey-check;

		kbd_keymap: keymap {
			compatible = "input-keymap";
			row-size = <3>;
			col-size = <5>;
			/* key n = INPUT_KEY_F13 + n, n = row * 4 + col; the knob push is
			 * wired into row 0, column 4 and is always key 16 */
			keymap = <MATRIX_KEY(0, 0, INPUT_KEY_F13)
				  MATRIX_KEY(0, 1, (INPUT_KEY_F13 + 1))
				  MATRIX_KEY(0, 2, (INPUT_KEY_F13 + 2))
				  MATRIX_KEY(0, 3, (INPUT_KEY_F13 + 3))
				  MATRIX_KEY(1, 0, (INPUT_KEY_F13 + 4))
				  MATRIX_KEY(1, 1, (INPUT_KEY_F13 + 5))
				  MATRIX_KEY(1, 2, (INPUT_KEY_F13 + 6))
				  MATRIX_KEY(1, 3, (INPUT_KEY_F13 + 7))
				  MATRIX_KEY(2, 0, (INPUT_KEY_F13 + 8))
				  MATRIX_KEY(2, 1, (INPUT_KEY_F13 + 9))
				  MATRIX_KEY(2, 2, (INPUT_KEY_F13 + 10))
				  MATRIX_KEY(2, 3, (INPUT_KEY_F13 + 11))
				  MATRIX_KEY(0, 4, (INPUT_KEY_F13 + 16))>;
		};
	};

	knob: knob {
		compatible = "gpio-qdec";
		gpios = <&gpio0 9 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>,
			<&gpio0 10 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
		steps-per-period = <4>;
		zephyr,axis = <INPUT_REL_WHEEL>;
		sample-time-us = <1000>;
		idle-timeout-ms = <200>;
	};

	backlight_pwm {
		compatible = "pwm-leds";

		lcd_backlight: lcd_backlight {
			pwms = <&pwm1 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
			label = "LCD backlight";
		};
	};

	lcd_dbi: lcd_mipi_dbi {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&spi3>;
		dc-gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio1 15 GPIO_ACTIVE_LOW>;
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		/* Waveshare 2inch LCD Module (ST7789V, 240 x 320), used landscape.
		 * See the DK overlay for the mdac note. */
		lcd: st7789v@0 {
			compatible = "sitronix,st7789v";
			reg = <0>;
			mipi-max-frequency = <16000000>;
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
			width = <320>;
			height = <240>;
			x-offset = <0>;
			y-offset = <0>;
			vcom = <0x1f>;
			gctrl = <0x35>;
			vrhs = <0x12>;
			vdvs = <0x20>;
			mdac = <0x70>;
			gamma = <0x01>;
			colmod = <0x05>;
			lcm = <0x2c>;
			porch-param = [0c 0c 00 33 33];
			cmd2en-param = [5a 69 02 01];
			pwctrl1-param = [a4 a1];
			pvgam-param = [d0 08 11 08 0c 15 39 33 50 36 13 14 29 2d];
			nvgam-param = [d0 08 10 08 06 06 39 44 51 0b 16 14 2f 31];
			ram-param = [00 f0];
			rgb-param = [cd 08 14];
		};
	};
};

/* SPIM3 is the only nRF52840 SPI master that goes above 8 MHz */
&spi3 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	cs-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&lcd_spi_default>;
	pinctrl-1 = <&lcd_spi_sleep>;
	pinctrl-names = "default", "sleep";
};

&pwm1 {
	status = "okay";
	pinctrl-0 = <&lcd_bl_pwm_default>;
	pinctrl-1 = <&lcd_bl_pwm_sleep>;
	pinctrl-names = "default", "sleep";
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_2";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_VDDHDIV5>;
		zephyr,resolution = <12>;
	};
};

/* The board file enables these on pins we use for the matrix and the knob */
&i2c0 {
	status = "disabled";
};

&i2c1 {
	status = "disabled";
};

&spi2 {
	status = "disabled";
};

/* Logs go to the USB serial port (board_cdc_acm_uart) instead */
&uart0 {
	status = "disabled";
};

&pinctrl {
	lcd_spi_default: lcd_spi_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 17)>,
				<NRF_PSEL(SPIM_MOSI, 0, 20)>;
			nordic,drive-mode = <NRF_DRIVE_H0H1>;
		};
	};

	lcd_spi_sleep: lcd_spi_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 17)>,
				<NRF_PSEL(SPIM_MOSI, 0, 20)>;
			low-power-enable;
		};
	};

	lcd_bl_pwm_default: lcd_bl_pwm_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 2)>;
		};
	};

	lcd_bl_pwm_sleep: lcd_bl_pwm_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 2)>;
			low-power-enable;
		};
	};
};
